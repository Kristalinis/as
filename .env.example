# --- required -------------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=123456:ABC-your-token
# Your Telegram user id(s), comma separated (get it from @userinfobot)
ADMIN_IDS=123456789

# --- payments -------------------------------------------------------------
# Solana wallet that receives crypto payments (leave empty to accept only Telegram Stars)
SOLANA_RECEIVER=YourSolanaWalletAddressHere
# Public RPC works for low volume; for production use a free Helius/QuickNode/Alchemy URL
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Any of SOL, USDC, USDT
ACCEPT_TOKENS=SOL,USDC,USDT
# Telegram Stars per $1 of price (0 = Stars off). You receive roughly $0.013 per Star when withdrawing.
STARS_PER_USD=50
INVOICE_TTL_MINUTES=30
POLL_INTERVAL_SECONDS=15

# --- products -------------------------------------------------------------
# Default premium chats (-100...) for subscription products that have no chats set in catalog.json
PREMIUM_CHAT_IDS=
CATALOG_FILE=catalog.json

# --- growth (all editable later in /admin → Settings) ----------------------
TRIAL_DAYS=0
REFERRAL_PERCENT=20
REFERRAL_BONUS_DAYS=0
MIN_PAYOUT_USD=20
# Discount offered to expired members 1 and 7 days after expiry (0 = off)
WINBACK_PERCENT=20
WINBACK_VALID_DAYS=3
# Suggest a longer, cheaper-per-day plan at checkout (1 = on)
UPSELL=1

# --- misc -----------------------------------------------------------------
# Kick people who join the premium chats without an active subscription
STRICT_MEMBERSHIP=true
SUPPORT_CONTACT=@your_support_username
DB_PATH=data/bot.db
