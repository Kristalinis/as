# --- required -------------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=123456:ABC-your-token
# Your Telegram user id(s), comma separated (get it from @userinfobot)
ADMIN_IDS=123456789
# Solana wallet that receives payments (Phantom/Solflare address)
SOLANA_RECEIVER=YourSolanaWalletAddressHere
# Private channel/group ids the subscription unlocks, comma separated (-100...)
PREMIUM_CHAT_IDS=-1001234567890

# --- payments -------------------------------------------------------------
# Public RPC works for low volume; for production use a free Helius/QuickNode/Alchemy URL
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Any of SOL, USDC, USDT
ACCEPT_TOKENS=SOL,USDC,USDT
INVOICE_TTL_MINUTES=30
POLL_INTERVAL_SECONDS=15

# --- growth ---------------------------------------------------------------
# Free trial length in days (0 = disabled)
TRIAL_DAYS=0
# Affiliate commission in % of each payment made by invited users (0 = disabled)
REFERRAL_PERCENT=20
# Bonus days for the inviter when an invited user buys the first time (0 = disabled)
REFERRAL_BONUS_DAYS=0
MIN_PAYOUT_USD=20

# --- misc -----------------------------------------------------------------
# Kick people who join the premium chats without an active subscription
STRICT_MEMBERSHIP=true
SUPPORT_CONTACT=@your_support_username
DB_PATH=data/bot.db
PLANS_FILE=plans.json
